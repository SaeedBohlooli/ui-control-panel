# Environment variables for development
# Copy this file to .env.local and customize for your project
#
# Configuration hierarchy (highest to lowest priority):
# 1. Environment variables (.env files) - HIGHEST PRIORITY
# 2. YAML config file (config.yaml)
# 3. Hardcoded defaults

# Project identifier (must match a key in appConfig.js projects object)
VITE_PROJECT_NAME=u106_multi_account_algo_trading

# Vite dev server port (default: 7106)
VITE_PORT=7106

# WebSocket server configuration
VITE_WS_URL=ws://127.0.0.1:6106
VITE_WS_PORT=6106

# WebSocket reconnection settings (optional)
# VITE_WS_RECONNECT_INITIAL=1000
# VITE_WS_RECONNECT_MAX=30000
# VITE_WS_RECONNECT_MULTIPLIER=2

# API server configuration
VITE_API_URL=http://127.0.0.1:5106
VITE_API_PORT=5106

