              borderRadius: 6,
              cursor: 'pointer'
            }}>
              Application State
            </button>
          </Link>
          <Link to="/application_state_details">
            <button style={{ 
              padding: '12px 24px', 
              fontSize: 16,
              background: '#3b82f6',
              color: 'white',
              border: 'none',
              borderRadius: 6,
              cursor: 'pointer'
            }}>
              Application State Details
            </button>
