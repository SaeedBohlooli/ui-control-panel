# Example Application Configuration File
# Copy this file to config.yaml and customize for your project
#
# Configuration hierarchy (highest to lowest priority):
# 1. Environment variables (.env files) - HIGHEST PRIORITY
# 2. YAML config file (config.yaml) - THIS FILE
# 3. Hardcoded defaults

# Project identifier
projectName: u106_multi_account_algo_trading

# Server ports
ports:
  vite: 7106
  websocket: 6106
  api: 5106

# WebSocket configuration
websocket:
  url: ws://127.0.0.1:6106
  reconnect:
    initialDelay: 1000
    maxDelay: 30000
    backoffMultiplier: 2

# API configuration
api:
  baseUrl: http://127.0.0.1:5106
  endpoints:
    sendRequest: /api/send-request

# Message types
messageTypes:
  applicationState: application_state
  appConfig: app_config
